</body>




    <!-- ========================= -->
    <!-- ENVIRONMENT               -->
    <!-- ========================= -->

    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" />

    <body name="table1" pos="0 0 0" euler="0 0 -3.14159265359">
      <inertial pos="0 0 0" mass="100" diaginertia="1 1 1" />
      <geom type="mesh" mesh="Modul_Roboter_asm" material="steel" condim="4" conaffinity="1"
        contype="1" />
    </body>

    <!-- plate1 -->
    <body name="plate1" pos="0 -0.145 0.95" euler="0 0 -3.14159265359">
      <inertial pos="0 0 0" mass="10" diaginertia="1 1 1" />
      <geom type="mesh" mesh="Adapterplatte_UR5" material="steel" condim="4" />
    </body>

    <!--table2-->
    <body name="table2" pos="0 0.811 0.0" euler="0 0 0">
