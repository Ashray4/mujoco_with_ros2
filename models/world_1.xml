<mujoco>
  

  <compiler autolimits="true" angle="radian" inertiafromgeom="true" texturedir="textures" meshdir="environment" />

  <option timestep="0.002" integrator="RK4" gravity="0 0 -9.81" cone="elliptic" impratio="10">
    <flag energy="enable" contact="enable" /> <!-- viscosity="0.1"  -->
  </option>
  <!-- Add some fluid viscosity to prevent things from jiggling forever -->
  <!-- condim="4", solimp="0.99 0.99 0.01", solref="0.01 1", and solver="elliptic"  for the better contact-->
  <asset>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512" rgb1=".1 .2 .3" rgb2=".2 .3 .4" />
    <material name="grid" texture="grid" texrepeat="1 1" texuniform="true" reflectance=".2" />
    <texture name="iron" type="2d" builtin="flat" height="32" width="32" rgb1="0.45 0.45 0.45" />
    <material name="steel" texture="iron" shininess="0.9" specular="0.75" reflectance="0.3"/>
    <mesh file="table.stl" />
    <mesh file="Simplyfied_Galgen_2.stl" />
    <mesh file="Modul_Roboter_asm.stl" />
    <mesh file="Adapterplatte_UR5.stl" />
    <mesh file="hole_rounded_edge.stl" />
    <mesh file="hole_large.stl" />
    <mesh file="hole_huge.stl" />
    <mesh file="triangle_hole.stl" />
    <mesh file="square_hole.stl" />
    <mesh file="pentagon_hole.stl" />
    <mesh file="hexagon_hole.stl" />
    <mesh file="block_w_hole_m.stl" />
  </asset>
  <!-- <include file="d435i.xml" /> -->
